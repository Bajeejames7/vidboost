{
  "manifest_version": 3,
  "name": "VidBoost",
  "version": "1.0.0",
  "description": "Bigger buffers, smarter quality, fewer ads - smoother streaming on slow internet.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true },
    { "matches": ["<all_urls>"], "js": ["boost.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "MAIN" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "VidBoost" }
}
